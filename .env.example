# Front (Vite) — obrigatório para build e dev
VITE_SUPABASE_URL=https://SEU_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sua_anon_key

# GitHub Pages local preview (opcional; no CI vem do workflow)
# VITE_BASE_PATH=/planeja-ia/

# Identificação no cabeçalho do relatório de Tarefas (opcional; sem valor, não é impressa)
# Logo: URL de imagem PNG ou JPEG acessível pelo navegador
# VITE_RELATORIO_ORGAO=
# VITE_RELATORIO_SETOR=
# VITE_RELATORIO_LOGO_URL=

# Restore de backup (tools/sync-database-from-backup.mjs) — nunca commitar
# BACKEND_URL=https://SEU_PROJECT_REF.supabase.co
# BACKEND_SERVICE_KEY=sua_service_role_key
